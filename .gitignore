**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# SQLite databases, including WAL/SHM sidecars
*.sqlite
*.sqlite-*
*.sqlite3
*.db

# Environment and secrets — never commit a real .env
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Frontend build output and dependencies
**/node_modules/
**/dist/
**/coverage/

# OS and editor noise
.DS_Store
__pycache__/
*.py[cod]

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
