# BrainDrop production environment
#
# Copy this file to `.env` and fill in the secrets. Never commit `.env`.
#
#   cp .env.example .env
#   # edit .env, then
#   docker compose up -d
#
# The paths below are the Docker layout (`/data` is the persistent volume).
# For a native install, point DATABASE_URL and QUEUE_URL at
# /opt/braindrop/shared/data instead. See docs/DEPLOYMENT.md.

# ---- Runtime --------------------------------------------------------------
LOCO_ENV=production
PORT=5150
BINDING=0.0.0.0
# Public URL used in outgoing mail links. Change to your real HTTPS origin.
HOST=http://localhost:5150
LOG_LEVEL=info

# ---- Database and queue (persistent volume) -------------------------------
DATABASE_URL=sqlite:///data/braindrop.sqlite?mode=rwc
QUEUE_URL=sqlite:///data/braindrop_queue.sqlite?mode=rwc
# Single-replica installs can migrate on boot. Set false when you run
# `braindrop db migrate` as a separate release step.
DB_AUTO_MIGRATE=true
DB_MAX_CONNECTIONS=4

# ---- Authentication -------------------------------------------------------
# Loco base64-decodes this value before signing. Generate one with:
#   openssl rand -base64 32
# The app refuses to boot while this is empty.
JWT_SECRET=
ALLOW_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
# Client address source used by authentication rate limits. Keep ConnectInfo
# (the socket peer) when the app is exposed directly or through a proxy that
# preserves it. Set RightmostXForwardedFor ONLY behind one trusted reverse
# proxy that overwrites X-Forwarded-For; never trust a client-supplied header.
REMOTE_IP_SOURCE=ConnectInfo

# ---- Mail (optional) ------------------------------------------------------
# Leave disabled for a manual-only install. Enable only when you need email
# verification, password reset or magic links. MAILER_HOST is required when
# MAILER_ENABLED=true.
MAILER_ENABLED=false
MAILER_HOST=
MAILER_PORT=587
MAILER_SECURE=true
MAILER_USER=
MAILER_PASSWORD=

# ---- Optional AI (leave disabled for a manual-only install) ---------------
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=8000
AI_RATE_LIMIT_PER_MINUTE=10
# Required only for per-user (BYOK) keys. Generate with:
#   openssl rand -base64 32
# Keep it stable and back it up: rotating it makes stored personal keys
# unreadable. Never let a deploy regenerate it.
AI_ENCRYPTION_KEY=

# ---- Optional notifications (leave empty for no delivery) -----------------
# Falls back to AI_ENCRYPTION_KEY when empty. Generate with:
#   openssl rand -base64 32
# Keep it stable and back it up: rotating it makes stored Telegram/Discord
# credentials unreadable. Never let a deploy regenerate it.
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_HISTORY_RETENTION_DAYS=30
NOTIFICATION_TEST_RATE_LIMIT=5
